{
  "name": "persian-gif-bot",
  "version": "1.1.0",
  "description": "High-performance Persian GIF Telegram Bot powered by Cloudflare Workers, grammY, and D1 FTS5",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply persian-gif-db --local",
    "db:remote": "wrangler d1 migrations apply persian-gif-db --remote",
    "set-commands": "tsx scripts/set-commands.ts"
  },
  "keywords": [
    "telegram-bot",
    "cloudflare-workers",
    "grammy",
    "cloudflare-d1",
    "fts5",
    "inline-bot"
  ],
  "author": "Alireza Rahimapanah",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.17"
  }
}
